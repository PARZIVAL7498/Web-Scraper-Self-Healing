# Bright Data Scraper Studio / Web Unlocker Configuration
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_ZONE=cli_unlocker
BRIGHTDATA_COLLECTOR_ID=c_your_collector_id_here
TARGET_URL=https://duckdb.org/docs/
# Set to 1 only for emergency Unlocker/HTTP fallback (Studio-first is default)
SCRAPE_ALLOW_FALLBACK=0

# LLM — OpenRouter (primary)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional secondary LLM keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=8000
